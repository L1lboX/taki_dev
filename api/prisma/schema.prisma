generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  ACCOUNTANT
  CASHIER
  COOK
  WAITER
}

enum TableStatus {
  FREE
  OCCUPIED
}

enum QrStatus {
  PENDING
  GENERATED
  PRINTED
}

enum OrderSource {
  WAITER
  QR
}

enum OrderStatus {
  DRAFT
  PENDING_WAITER_APPROVAL
  APPROVED
  SENT_TO_KITCHEN
  PREPARING
  READY
  DELIVERED
  CLOSED
  CANCELLED
}

enum KitchenTicketStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum ServiceMode {
  DINE_IN
  TAKEAWAY
}

enum SplitMode {
  TABLE_TOTAL
  SPLIT
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  role      Role
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tableSessions TableSession[] @relation("TableSessionCreator")
  orders        Order[]        @relation("OrderCreator")
}

model Salon {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(1)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tables DiningTable[]
}

model DiningTable {
  id              String        @id @default(cuid())
  salonId         String
  number          Int
  capacity        Int
  status          TableStatus   @default(FREE)
  active          Boolean       @default(true)
  activeSessionId String?
  qrStatus        QrStatus      @default(PENDING)
  qrToken         String?       @unique
  qrGeneratedAt   DateTime?
  qrPrintedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  salon    Salon          @relation(fields: [salonId], references: [id])
  sessions TableSession[]
  orders   Order[]

  @@unique([salonId, number])
}

model TableSession {
  id              String   @id @default(cuid())
  tableId         String
  guestsActive    Int
  createdByUserId String
  createdAt       DateTime @default(now())
  closedAt        DateTime?

  table         DiningTable @relation(fields: [tableId], references: [id])
  createdByUser User        @relation("TableSessionCreator", fields: [createdByUserId], references: [id])
  orders        Order[]
}

model CatalogItem {
  id        String   @id @default(cuid())
  name      String
  type      String
  basePrice Decimal  @db.Decimal(10, 2)
  isMenu    Boolean  @default(false)
  variants  Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems     OrderItem[]
  inventoryItems InventoryItem[]
}

model Order {
  id               String      @id @default(cuid())
  tableId          String
  tableSessionId   String
  createdByUserId  String
  source           OrderSource
  status           OrderStatus
  approvedByUserId String?
  splitMode        SplitMode   @default(TABLE_TOTAL)
  subtotal         Decimal     @default(0) @db.Decimal(10, 2)
  takeawayFee      Decimal     @default(0) @db.Decimal(10, 2)
  total            Decimal     @default(0) @db.Decimal(10, 2)
  createdAt        DateTime    @default(now())
  closedAt         DateTime?

  table        DiningTable   @relation(fields: [tableId], references: [id])
  tableSession TableSession  @relation(fields: [tableSessionId], references: [id])
  createdBy    User          @relation("OrderCreator", fields: [createdByUserId], references: [id])
  items        OrderItem[]
  kitchenTicket KitchenTicket?
  payment      Payment?
}

model OrderItem {
  id          String      @id @default(cuid())
  orderId     String
  catalogId   String
  productName String
  quantity    Int
  unitPrice   Decimal     @db.Decimal(10, 2)
  variant     String?
  notes       String?
  guestNumber Int?
  serviceMode ServiceMode
  isMenu      Boolean     @default(false)

  order      Order        @relation(fields: [orderId], references: [id])
  catalog    CatalogItem  @relation(fields: [catalogId], references: [id])
  extras     OrderExtra[]
}

model OrderExtra {
  id          String  @id @default(cuid())
  orderItemId String
  catalogId   String
  name        String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
}

model KitchenTicket {
  id            String             @id @default(cuid())
  orderId        String             @unique
  status         KitchenTicketStatus
  printed        Boolean            @default(false)
  printAttempts  Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  order Order @relation(fields: [orderId], references: [id])
}

model CashSession {
  id               String    @id @default(cuid())
  date             DateTime
  status           String
  openingAmount    Decimal   @db.Decimal(10, 2)
  countedCashAmount Decimal? @db.Decimal(10, 2)
  openedAt         DateTime
  closedAt         DateTime?
  openedByUserId   String
  closedByUserId   String?

  payments Payment[]
}

model Payment {
  id            String   @id @default(cuid())
  orderId       String   @unique
  cashSessionId String
  splitMode     SplitMode
  total         Decimal  @db.Decimal(10, 2)
  paidAmount    Decimal  @db.Decimal(10, 2)
  changeAmount  Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  order       Order       @relation(fields: [orderId], references: [id])
  cashSession CashSession @relation(fields: [cashSessionId], references: [id])
  methods     PaymentMethodLine[]
}

model PaymentMethodLine {
  id        String        @id @default(cuid())
  paymentId String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)

  payment Payment @relation(fields: [paymentId], references: [id])
}

model InventoryItem {
  id                String   @id @default(cuid())
  catalogItemId     String
  stock             Int
  lowStockThreshold Int
  updatedAt         DateTime @updatedAt

  catalog CatalogItem @relation(fields: [catalogItemId], references: [id])
}

model RuntimeState {
  id        String   @id
  payload   Json
  updatedAt DateTime @updatedAt
}


